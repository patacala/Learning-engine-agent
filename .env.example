# Database
DATABASE_URL=postgresql+asyncpg://learning_engine:learning_engine@localhost:5432/learning_engine
DATABASE_SYNC_URL=postgresql://learning_engine:learning_engine@localhost:5432/learning_engine

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# LLM Config
PRIMARY_LLM_PROVIDER=openai
PRIMARY_LLM_MODEL=gpt-4o
ANALYZER_LLM_MODEL=gpt-4o-mini

# App
APP_ENV=development
LOG_LEVEL=INFO

# Internal API token — required by internal/training endpoints in non-dev envs.
# Also signs the UI's login session cookie; the frontend no longer needs it.
INTERNAL_API_TOKEN=

# Password for the LearningEngine UI login screen (POST /auth/login), required in
# non-dev envs.
UI_LOGIN_PASSWORD=
