# Database
DATABASE_URL=postgresql+asyncpg://prosales:prosales@localhost:5432/prosales
DATABASE_SYNC_URL=postgresql://prosales:prosales@localhost:5432/prosales

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# LLM Config
PRIMARY_LLM_PROVIDER=openai
PRIMARY_LLM_MODEL=gpt-4o
ANALYZER_LLM_MODEL=gpt-4o-mini

# App
APP_ENV=development
LOG_LEVEL=INFO

# Internal API token — required by internal/training endpoints in non-dev envs.
# The frontend must be built with the same value in VITE_INTERNAL_TOKEN.
INTERNAL_API_TOKEN=
