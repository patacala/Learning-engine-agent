# Production environment template for Coolify (docker-compose.prod.yml).
# Set these in Coolify's UI. DO NOT commit real secrets. DATABASE_URL /
# DATABASE_SYNC_URL / REDIS_URL are built automatically inside the compose from
# the values below — you do NOT set them by hand.

# --- Required secrets ---
POSTGRES_PASSWORD=change-me-strong-password
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Internal/training endpoints (learning, testing, agents, timeline, roleplay,
# assistant, episode) reject ALL requests in production if this is unset. Also
# signs the UI's login session cookie.
INTERNAL_API_TOKEN=change-me-strong-token
# Password for the ProSales UI login screen (POST /auth/login) — required in
# production; the browser never sees INTERNAL_API_TOKEN directly.
UI_LOGIN_PASSWORD=change-me-strong-password

# --- Optional (leave blank to disable the feature) ---
RETELL_API_KEY=
CRM_WEBHOOK_URL=
PROVISIONING_SECRET=

# --- App config (have sane defaults; override if needed) ---
PRIMARY_LLM_PROVIDER=openai
PRIMARY_LLM_MODEL=gpt-4o
ANALYZER_LLM_MODEL=gpt-4o-mini
LOG_LEVEL=INFO
WEB_WORKERS=4
